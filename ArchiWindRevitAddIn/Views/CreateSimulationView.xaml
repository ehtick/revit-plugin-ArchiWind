<Window
    x:Class="ArchiWindRevitAddIn.Views.CreateSimulationView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:viewModel="clr-namespace:ArchiWindRevitAddIn.ViewModels"
    xmlns:converter="clr-namespace:ArchiWindRevitAddIn.Views.Converters"
    xmlns:apiModels="clr-namespace:ArchiwindRevitAddIn.Api.Models"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance viewModel:CreateSimulationViewModel}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    Title="Create Simulation"
    Height="Auto"
    Width="650"
    SizeToContent="Height"
    Icon="/ArchiWindRevitAddIn;component/Resources/Icons/icon.ico">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCoordinatesFromDocument}" />
            <i:InvokeCommandAction Command="{Binding DoUpdateGeometriesControls}" />
            <i:InvokeCommandAction Command="{Binding LoadProjects}" />
            <i:InvokeCommandAction Command="{Binding LoadBillingStatus}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    
    <Window.Resources>
        <converter:EnumBooleanConverter x:Key="EnumBooleanConverter" />
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <GroupBox Name="General" Grid.Row="0" Header="General">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="35" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Grid.Row="0" Content="Project:" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" />
                <Grid Grid.Column="1" Grid.Row="0" Margin="0,0,5,0"  VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox
                        Grid.Column="0"
                        IsEnabled="{Binding IsProjectSelectionEnabled}"
                        SelectedItem="{Binding Path=SelectedProject, ValidatesOnNotifyDataErrors=True}"
                        ItemsSource="{Binding Path=Projects}"
                        DisplayMemberPath="Name"
                        ToolTip="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}" />
                    <Button Grid.Column="1" Content="Refresh" Margin="10,2,0,2" Command="{Binding LoadProjects}"/>
                </Grid>

                <Label Grid.Column="0" Grid.Row="1" Content="Name:" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" />
                <TextBox Grid.Column="1" Grid.Row="1" Margin="0,0,5,0"  VerticalAlignment="Center" MinHeight="25"
                         Text="{Binding Path=Name, ValidatesOnNotifyDataErrors=True}"
                         ToolTip="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}" />

                <Label Grid.Column="0" Grid.Row="2" Content="Quality:" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" />
                <Grid Grid.Column="1" Grid.Row="2" Margin="0,4,5,4" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <RadioButton Grid.Column="0" GroupName="Quality" Content="Draft"
                                 IsChecked="{Binding SelectedQuality, Converter={StaticResource EnumBooleanConverter}, ConverterParameter={x:Static apiModels:SimulationQuality.Draft}}" />
                    <RadioButton Grid.Column="1" GroupName="Quality" Content="Detailed"
                                 IsChecked="{Binding SelectedQuality, Converter={StaticResource EnumBooleanConverter}, ConverterParameter={x:Static apiModels:SimulationQuality.Detailed}}"/>
                </Grid>

                <Label Grid.Column="0" Grid.Row="3" Content="Coordinates (WSG 84):" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" />
                <Grid Grid.Column="1" Grid.Row="3" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        Text="{Binding Latitude, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                        ToolTip="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}" />

                    <Label Grid.Column="1" Content="lat" HorizontalAlignment="Left" />

                    <TextBox
                        Grid.Column="2" 
                        Text="{Binding Longitude, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                        ToolTip="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}" />

                    <Label Grid.Column="3" Content="lon" HorizontalAlignment="Left" />

                    <Button Grid.Column="4" Content="From document..." Margin="0,2,5,2" Command="{Binding LoadCoordinatesFromDocument}" />
                </Grid>
            </Grid>
        </GroupBox>

        <Expander Grid.Row="1">
            <Expander.Header>Advanced Settings</Expander.Header>

            <Expander.Content>
                <Grid HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" Grid.Row="0" Content="EPSG:" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" />
                    <ComboBox
                        Grid.Column="1"
                        Grid.Row="0"
                        Margin="5,5,0,5"
                        Width="140"
                        HorizontalAlignment="Left"
                        MinHeight="25"
                        SelectedItem="{Binding Path=SelectedRefSystem, ValidatesOnNotifyDataErrors=True}"
                        ItemsSource="{Binding Path=RefSystems}"
                        ToolTip="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}"
                        />
                    <Button
                        Grid.Column="2"
                        Content="Clear"
                        Width="75"
                        Margin="10,7,0,7"
                        HorizontalAlignment="Left"
                        Command="{Binding ClearRefSystem}"
                        />
                </Grid>
            </Expander.Content>

        </Expander>

        <GroupBox Name="Geometries" Grid.Row="2" Margin="0,5,0,0" Header="Geometries" IsEnabled="{Binding AreViewGeometriesLoaded}">
            <Grid Margin="10,10,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <CheckBox Grid.Column="0" Grid.Row="0" Content="Building"
                          IsChecked="{Binding HasBuilding, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding IsBuildingEnabled}"
                          ToolTip="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}" />
                <CheckBox Grid.Column="1" Grid.Row="0" Content="Surroundings"
                          IsChecked="{Binding HasSurroundings, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding AreSurroundingsEnabled}"
                          ToolTip="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}" />
                <CheckBox Grid.Column="2" Grid.Row="0" Content="Terrain"
                          IsChecked="{Binding HasTerrain, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding IsTerrainEnabled}"
                          ToolTip="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}" />
                <CheckBox Grid.Column="3" Grid.Row="0" Content="Vegetation"
                          IsChecked="{Binding HasVegetation, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding IsVegetationEnabled}"
                          ToolTip="{Binding (Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,5" Text="{Binding BuildingViewStatus}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,5" Text="{Binding SurroundingsViewStatus}" />
                <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,5" Text="{Binding TerrainViewStatus}" />
                <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,5" Text="{Binding VegetationViewStatus}" />
            </Grid>
        </GroupBox>

        <Grid Name="Actions" Grid.Row="3" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="75"/>
                <ColumnDefinition Width="75"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding BillingPlanNotice}" Margin="10,10" HorizontalAlignment="Left"/>
            <TextBlock Grid.Column="1" Text="{Binding CostNotice}" Margin="10,10,20,10" HorizontalAlignment="Right"/>

            <Button Grid.Column="2" Width="65" Content="Create" Command="{Binding CreateCommand}" Margin="0,10,10,10" IsDefault="True" HorizontalAlignment="Right"/>
            <Button Grid.Column="3" Width="65" Content="Cancel" Margin="0,10,10,10" IsCancel="True" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
